      <property key="archipelago.style" value="[{&quot;id&quot;:&quot;o-group&quot;,&quot;textAlignment&quot;:&quot;left&quot;},{&quot;id&quot;:&quot;o-legend&quot;,&quot;legend&quot;:&quot;display=15,rows=15,offset=0,color=1,sort=1&quot;,&quot;name&quot;:&quot;Legend&quot;,&quot;textAlignment&quot;:&quot;left&quot;},{&quot;id&quot;:&quot;o-new-legend&quot;,&quot;legend&quot;:&quot;display=15,rows=15,offset=0,color=1,sort=1&quot;,&quot;name&quot;:&quot;Legend&quot;},{&quot;id&quot;:&quot;o-note&quot;,&quot;textAlignment&quot;:&quot;left&quot;}]"/>
    </element>
