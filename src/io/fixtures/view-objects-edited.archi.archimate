      </child>
      <property key="archipelago.style" value="[{&quot;id&quot;:&quot;o-detail-legend&quot;,&quot;legend&quot;:&quot;display=5,rows=3,offset=20,color=0,sort=0&quot;,&quot;name&quot;:&quot;Legend&quot;,&quot;textAlignment&quot;:&quot;left&quot;}]"/>
    </element>
    <element xsi:type="archimate:ArchimateDiagramModel" name="Main" id="v-main">
      <child xsi:type="archimate:DiagramObject" id="o-actor" targetConnections="c-serving c-line" archimateElement="e-actor">
        <bounds x="24" y="24" width="120" height="55"/>
      </child>
      <child xsi:type="archimate:Group" id="o-group" name="Front of house" textAlignment="1">
