      </child>
      <child xsi:type="archimate:Note" id="o-detail-legend" textAlignment="1">
        <bounds x="200" y="24" width="200" height="120"/>
      </child>
      <child xsi:type="archimate:DiagramModelReference" id="o-ref-main" model="v-main">
