<?xml version="1.0" encoding="UTF-8"?>
<!--
  Everything in the exchange format's views and organizations that Archipelago
  cannot carry, one of each (#76). Written by hand for Archipelago; MIT.
  The reader must name each of these in its problem list.
-->
<model xmlns="http://www.opengroup.org/xsd/archimate/3.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" identifier="m-unsupported">
  <name xml:lang="en">Unsupported view constructs</name>
  <elements>
    <element identifier="e-app" xsi:type="ApplicationComponent"><name xml:lang="en">App</name></element>
    <element identifier="e-svc" xsi:type="ApplicationService"><name xml:lang="en">Service</name></element>
  </elements>
  <relationships>
    <relationship identifier="r-real" source="e-app" target="e-svc" xsi:type="Realization" />
  </relationships>
  <organizations>
    <item>
      <label xml:lang="en">Application</label>
      <item identifierRef="e-app" />
      <item identifierRef="e-gone" />
    </item>
    <item>
      <label xml:lang="en">My stuff</label>
      <item identifierRef="e-svc" />
      <item identifierRef="e-app" />
    </item>
  </organizations>
  <views>
    <diagrams>
      <view identifier="v-main" xsi:type="Diagram">
        <name xml:lang="en">Main</name>
        <node identifier="n-app" elementRef="e-app" xsi:type="Element" x="0" y="0" w="120" h="55" />
        <node identifier="n-svc" elementRef="e-svc" xsi:type="Element" x="200" y="0" w="120" h="55" />
        <node identifier="n-ghost" elementRef="e-gone" xsi:type="Element" x="0" y="100" w="120" h="55">
          <node identifier="n-orphan" xsi:type="Label" x="10" y="110" w="80" h="30">
            <label xml:lang="en">Kept, though its container was not</label>
          </node>
        </node>
        <node identifier="n-bound" xsi:type="Label" conceptRef="e-app" x="400" y="0" w="120" h="40">
          <label xml:lang="en">App</label>
        </node>
        <node identifier="n-elsewhere" xsi:type="Label" x="400" y="100" w="120" h="40">
          <label xml:lang="en">Old view</label>
          <viewRef ref="v-missing" />
        </node>
        <node identifier="n-picture" xsi:type="Image" x="400" y="200" w="60" h="60" />
        <connection identifier="c-real" relationshipRef="r-real" xsi:type="Relationship" source="n-app" target="n-svc">
          <sourceAttachment x="60" y="27" />
          <targetAttachment x="260" y="27" />
        </connection>
        <connection identifier="c-on-connection" xsi:type="Line" source="n-bound" target="c-real" />
        <connection identifier="c-dangling" relationshipRef="r-gone" xsi:type="Relationship" source="n-app" target="n-svc" />
      </view>
      <view identifier="v-sketch" xsi:type="Sketch">
        <name xml:lang="en">A sketch</name>
      </view>
    </diagrams>
  </views>
</model>
